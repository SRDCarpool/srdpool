# Copy to .env (or set these in your hosting dashboard).
# Docker:   docker run --env-file .env ...
# Node:     node --env-file=.env server/index.js
# Keep comments on their own lines (Docker reads everything after "=" as the value).

# ---------- Server ----------
# "production" serves the built app, requires email to be configured, locks the admin panel
# to ADMIN_EMAILS, and turns demo members off.
NODE_ENV=production
PORT=8080
# Where the SQLite database lives. Point this at a persistent disk/volume.
DATA_DIR=/data
TZ_NAME=Asia/Kolkata

# ---------- Admins ----------
# Comma-separated emails that get the admin dashboard after signing in.
ADMIN_EMAILS=you@yourcompany.com

# ---------- Sign-in emails (required in production) ----------
# Any SMTP provider works. Examples:
#   Google Workspace / Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465, SMTP_PASS = an App Password
#   Zoho Mail:                SMTP_HOST=smtp.zoho.in   SMTP_PORT=465
#   Brevo (free tier):        SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587
#   Amazon SES:               SMTP_HOST=email-smtp.ap-south-1.amazonaws.com SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SRDPool <no-reply@yourdomain.com>

# ---------- SOS text messages to trusted contacts (optional, Twilio) ----------
# Without these, SOS alerts still notify the safety team inside the app.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---------- Demo members ----------
# Off by default in production. Set 1 only for a demo/staging site.
DEMO_BOTS=0
SIM_SPEED_KM=0.22

# ---------- Maps ----------
CITY_NAME=Hyderabad
CITY_LAT=17.42
CITY_LNG=78.44
# The public OSRM / OpenStreetMap tile servers are for light use only.
# For real traffic, self-host OSRM or use a tile/routing provider (MapTiler, Stadia, Mapbox…).
OSRM_URL=https://router.project-osrm.org
GEO_USER_AGENT=SRDPool-carpool/1.0
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_ATTRIBUTION=© OpenStreetMap contributors
