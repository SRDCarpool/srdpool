# Copy to .env (or set in your hosting dashboard). All values are optional in development.
# Load with:  node --env-file=.env server/index.js

# --- Server ---
NODE_ENV=development          # "production" hides dev OTP codes and locks the admin panel
API_PORT=8787                 # dev API port (production uses PORT)
DATA_DIR=data                 # where the SQLite database lives
TZ_NAME=Asia/Kolkata

# --- Demo members (bots that accept requests, request seats, reply in chat) ---
DEMO_BOTS=1                   # set 0 for a real launch
SIM_SPEED_KM=0.22             # km per second when a drive is simulated

# --- Admins (production): comma-separated 10-digit mobile numbers ---
ADMIN_PHONES=
OPEN_ADMIN=1                  # dev only: everyone can open the admin panel

# --- SMS for OTP + SOS (Twilio). Without these, codes print to the server console ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Maps ---
CITY_NAME=Hyderabad
CITY_LAT=17.42
CITY_LNG=78.44

# Self-host or use a paid provider for production traffic:
OSRM_URL=https://router.project-osrm.org

GEO_USER_AGENT=Saathi-carpool-dev/0.1
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_ATTRIBUTION=© OpenStreetMap contributors
